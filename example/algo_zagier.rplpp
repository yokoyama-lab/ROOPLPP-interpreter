// Zagier's windmill involution (the "one-sentence proof" of Fermat's
// two-squares theorem), ported from PyJanus example/zagier.ja.
// The map is an involution on the triples with x^2 + 4yz = p, so calling
// it twice is the identity -- the exit assertions encode the theorem.
// ROOPL++ has no *=, so the negation x := -x is done with a local and <=>.
// (x,y,z) = (3,1,7) -> (1,9,1)   [3^2+4*1*7 = 37 = 1^2+4*9*1]

class Zagier
    method involution(int x, int y, int z)
        if x < y - z then
            x += 2 * z
            y <=> z
            z -= x - y
        else
            if x < 2 * y then
                x -= 2 * y
                local int neg = 0
                neg -= x
                neg <=> x
                delocal int neg = 0 - x
                z += y - x
            else
                x -= 2 * y
                y <=> z
                y += x + z
            fi x >= y - z
        fi x >= 2 * y

class Program
    int x
    int y
    int z
    method main()
        x += 3
        y += 1
        z += 7
        local Zagier w = nil
        new Zagier w
        call w::involution(x, y, z)
        delete Zagier w
        delocal Zagier w = nil
