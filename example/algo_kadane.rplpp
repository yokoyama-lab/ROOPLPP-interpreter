// Reversible Kadane's algorithm for maximum subarray sum
// a = [-2, 1, -3, 4, -1, 2, 1, -5, 4] -> max subarray sum = 6

class Kadane
    method maxSubarray(int[] a, int n, int maxSum, int[] curSums, int[] choices, int[] gains)
        curSums[0] += a[0]
        maxSum += a[0]
        for i in (1..n-1) do
            if a[i] > curSums[i-1] + a[i] then
                choices[i] ^= 1
                curSums[i] += a[i]
            else
                curSums[i] += curSums[i-1] + a[i]
            fi choices[i] = 1
            // 走行最大値の更新は「増分」を記録する。増分が正であることが
            // そのまま出口の表明になるので、逆向きの実行が枝を選び直せる
            // （maxSum -= maxSum は古い最大値を捨ててしまう）
            if curSums[i] > maxSum then
                gains[i] += curSums[i] - maxSum
                maxSum += gains[i]
            fi gains[i] > 0
        end

class Program
    int[] a
    int maxSum
    int[] curSums
    int[] choices
    int[] gains
    method main()
        new int[9] a
        new int[9] curSums
        new int[9] choices
        new int[9] gains
        a[0] -= 2
        a[1] += 1
        a[2] -= 3
        a[3] += 4
        a[4] -= 1
        a[5] += 2
        a[6] += 1
        a[7] -= 5
        a[8] += 4
        local Kadane k = nil
        new Kadane k
        local int n = 9
        call k::maxSubarray(a, n, maxSum, curSums, choices, gains)
        delocal int n = 9
        delete Kadane k
        delocal Kadane k = nil
