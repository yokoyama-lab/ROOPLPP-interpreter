// Reversible interval scheduling (greedy, pre-sorted by end time)
// Select max non-overlapping intervals
// Intervals sorted by end: [(1,3),(2,5),(4,7),(6,9),(8,10)]
// Selected: (1,3), (4,7), (8,10) -> count = 3

class IntervalSched
    method schedule(int[] start, int[] finish, int n, int count,
                    int[] selected, int[] ends)
        // First interval always selected
        selected[0] ^= 1
        count += 1
        local int lastEnd = finish[0]
        for i in (1..n-1) do
            if start[i] >= lastEnd then
                selected[i] ^= 1
                count += 1
                // 古い lastEnd を捨てずに「増分」を残す。これで逆向きの実行が
                // 前の終了時刻を復元できる
                ends[i] += finish[i] - lastEnd
                lastEnd += ends[i]
            fi selected[i] = 1
        end
        // 増分をすべて引き戻せば lastEnd は最初の値に戻る
        for i in (1..n-1) do
            lastEnd -= ends[i]
        end
        delocal int lastEnd = finish[0]

class Program
    int[] start
    int[] finish
    int count
    int[] selected
    int[] ends
    method main()
        new int[5] start
        new int[5] finish
        new int[5] selected
        new int[5] ends
        start[0] += 1
        start[1] += 2
        start[2] += 4
        start[3] += 6
        start[4] += 8
        finish[0] += 3
        finish[1] += 5
        finish[2] += 7
        finish[3] += 9
        finish[4] += 10
        local IntervalSched is = nil
        new IntervalSched is
        local int n = 5
        call is::schedule(start, finish, n, count, selected, ends)
        delocal int n = 5
        delete IntervalSched is
        delocal IntervalSched is = nil
