// Reversible Longest Increasing Subsequence via O(n^2) DP
// dp[i] = length of LIS ending at index i
// a = [10, 9, 2, 5, 3, 7, 101, 18] -> LIS length = 4 (e.g. [2,3,7,101])

class LIS
    method solve(int[] a, int n, int[] dp, int maxLen, int[] gains, int[] maxGains)
        for i in (0..n-1) do
            dp[i] += 1
            if i >= 1 then
                for j in (0..i-1) do
                    if a[j] < a[i] then
                        local int cand = dp[j] + 1
                        local int idx = i * n + j
                        // 増分だけを記録して足す。古い値を捨てないので逆向きに
                        // 戻せるし、増分が正であることが出口の表明になる
                        if cand > dp[i] then
                            gains[idx] += cand - dp[i]
                            dp[i] += gains[idx]
                        fi gains[idx] > 0
                        delocal int idx = i * n + j
                        delocal int cand = dp[j] + 1
                    fi a[j] < a[i]
                end
            fi i >= 1
            if dp[i] > maxLen then
                maxGains[i] += dp[i] - maxLen
                maxLen += maxGains[i]
            fi maxGains[i] > 0
        end

class Program
    int[] a
    int[] dp
    int maxLen
    int[] gains
    int[] maxGains
    method main()
        new int[8] a
        new int[8] dp
        new int[64] gains
        new int[8] maxGains
        a[0] += 10
        a[1] += 9
        a[2] += 2
        a[3] += 5
        a[4] += 3
        a[5] += 7
        a[6] += 101
        a[7] += 18
        local LIS l = nil
        new LIS l
        local int n = 8
        call l::solve(a, n, dp, maxLen, gains, maxGains)
        delocal int n = 8
        delete LIS l
        delocal LIS l = nil
